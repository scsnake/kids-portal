{
  "name": "one-stroke",
  "private": true,
  "version": "0.1.0",
  "description": "Kid's one-stroke geometry puzzle — 24 levels",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --loader:.js=jsx --define:process.env.NODE_ENV=\\\"production\\\" --outfile=dist/bundle.js",
